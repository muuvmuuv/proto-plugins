gitleaks = "8.30.1"
jq = "1.8.2"
just = "1.59.0"
lefthook = "2.2.2"
maestro = "2.11.0"
ripwire = "0.6.8"
sfw = "1.15.4"
v = "0.5.2"
yq = "4.54.1"

# Release builds on purpose: proto's shell hook loads every plugin on each
# prompt, and freeing the debug WASMs stalls each prompt for ~3 s on macOS
# (wasmtime deregisters every JIT frame one by one). `just setup` builds them.
[plugins]
gitleaks = "file://./target/wasm32-wasip1/release/gitleaks_tool.wasm"
jq = "file://./target/wasm32-wasip1/release/jq_tool.wasm"
just = "file://./target/wasm32-wasip1/release/just_tool.wasm"
lefthook = "file://./target/wasm32-wasip1/release/lefthook_tool.wasm"
maestro = "file://./target/wasm32-wasip1/release/maestro_tool.wasm"
ripwire = "file://./target/wasm32-wasip1/release/ripwire_tool.wasm"
sfw = "file://./target/wasm32-wasip1/release/sfw_tool.wasm"
v = "file://./target/wasm32-wasip1/release/v_tool.wasm"
yq = "file://./target/wasm32-wasip1/release/yq_tool.wasm"
